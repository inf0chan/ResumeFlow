{
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist/resumeflow-frontend/browser",
  "installCommand": "npm install --prefix frontend",
  "framework": "angular",
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
