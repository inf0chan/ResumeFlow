# Copy this file to .env before running.
#
# This app makes NO calls to any third-party API (no Stripe, no OpenAI, no
# email provider, etc.) — everything runs against your own MySQL database
# and your own Express server, so there are no external API keys to add
# here. The only secret this app actually needs is below.

PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# ─── Production (Render / cloud hosting) ───────────────────────────────────
# These are only needed when NODE_ENV=production.  For local development,
# config.json is used instead.
# DB_HOST=your-cloud-mysql-host
# DB_PORT=3306
# DB_NAME=resumeflow
# DB_USER=your-mysql-user
# DB_PASSWORD=your-mysql-password
# FRONTEND_URL=https://your-app.vercel.app
