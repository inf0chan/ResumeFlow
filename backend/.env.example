# Copy this file to .env before running.
#
# This app makes NO calls to any third-party API (no Stripe, no OpenAI, no
# email provider, etc.) — everything runs against your own Supabase PostgreSQL
# database and your own Express server, so there are no external API keys to
# add here. The only secret this app actually needs is below.

PORT=3000
JWT_SECRET=change-this-to-a-long-random-string
NODE_ENV=development

# ─── Supabase Database ────────────────────────────────────────────────────
# Get these from: https://supabase.com/dashboard → Settings → Database
# Connection string format:
#   postgres://postgres.[PROJECT_REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.aiskhxajmtxeajeanzqq
DB_PASSWORD=YOUR_SUPABASE_PASSWORD
# FRONTEND_URL=https://your-app.vercel.app
